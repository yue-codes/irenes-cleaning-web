---
import Container from './shared/Container.astro';
import ServicesSlider from './ServicesSlider.tsx';


---

<section id="services">
    <Container className="py-20 space-y-12">
        <div class="text-center max-w-3xl mx-auto">
            <h2 class="relative text-4xl lg:text-6xl text-center text-purple-800 font-bold underline-pink text-heading-1">
                Cleaning Services in Jersey City & Hoboken, NJ
            </h2>
        </div>
        <ServicesSlider client:visible />
    </Container>
</section>

<style>
    .underline-pink::after {
      content: '';
      display: block;
      width: 120px; /* Ajusta este valor para cambiar el ancho de la línea */
      height: 2px; /* Grosor de la línea */
      background-color: #8f08e9; /* Color rosa */
      position: absolute;
      bottom: -10px; /* Ajusta esta distancia según sea necesario */
      left: 50%; /* Centra la línea horizontalmente */
      transform: translateX(-50%); /* Centra la línea horizontalmente */
    }
  
  </style>