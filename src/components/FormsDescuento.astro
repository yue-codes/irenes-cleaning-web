<form id="hero-discount-form" action="/api/discount" method="POST"
    class="py-1 pl-6 w-full pr-1 flex gap-3 items-center shadow-lg border border-white/20 bg-white rounded-full">
    <span class="min-w-max pr-2 border-r border-gray-200 text-gray-400">
    <svg viewBox="0 0 24 24" 
    xmlns="http://www.w3.org/2000/svg" 
    width="24" 
    height="24" 
    fill="currentColor">
    <style>
        @keyframes phone {
        0%, to { transform: rotate(0deg); transform-origin: 0 100%; }
        10%, 90% { transform: rotate(2deg); }
        20%, 40%, 60% { transform: rotate(-4deg); }
        30%, 50%, 70% { transform: rotate(4deg); }
        80% { transform: rotate(-2deg); }
        }
    </style>
        <path fill="currentColor" d="M15.758 19a10.761 10.761 0 01-7.603-3.162A10.805 10.805 0 015 8.22c0-.854.339-1.673.941-2.277A3.21 3.21 0 018.214 5c.18-.001.36.015.537.05.172.024.34.067.503.125a.699.699 0 01.455.525l.957 4.2a.7.7 0 01-.182.644c-.09.098-.098.105-.957.553a6.93 6.93 0 003.402 3.423c.454-.868.461-.875.559-.966a.699.699 0 01.643-.182l4.191.959a.699.699 0 01.503.455A3.046 3.046 0 0119 15.829a3.223 3.223 0 01-.968 2.255 3.21 3.21 0 01-2.274.916zM8.215 6.4a1.822 1.822 0 00-1.817 1.82 9.396 9.396 0 002.744 6.63 9.36 9.36 0 006.617 2.75 1.821 1.821 0 001.817-1.82v-.231l-3.242-.75-.202.386c-.315.609-.545 1.05-1.132.812a8.276 8.276 0 01-5.016-5.047c-.251-.546.224-.798.824-1.113l.385-.189L8.444 6.4h-.23z" 
        style="animation:phone 1.5s cubic-bezier(1,.01,.75,2.17) both infinite"/>
    </svg>                                                                                                      
    </span>
    <input 
      type="tel" 
      name="phone" 
      id="phone" 
      placeholder="Your number: 201-523-8741" 
      class="w-full py-3 outline-none border-none bg-white text-gray-700 placeholder-gray-400 focus:ring-0"
      pattern="[0-9]*"
      maxlength="10"
      oninput="this.value = this.value.replace(/[^0-9]/g, '')"
      required
    >
    
    <button type="submit" class="inline-block rounded-full bg-purple-500 px-8 py-2 text-sm font-medium text-white transition duration-300 ease-in-out transform hover:bg-purple-700 hover:text-white hover:scale-105">
    20% OFF
    </button>
</form>

<script is:inline data-astro-rerun>
  // Función para configurar el comportamiento del formulario
  function setupKeenSlider() {
    // Obtiene el formulario por su ID
    const form = document.getElementById('hero-discount-form');
    if (form) {
      // Agrega un evento de envío al formulario
      form.addEventListener('submit', function(event) {
        event.preventDefault();
        const formData = new FormData(form);
        const phoneInput = form.querySelector('input[name="phone"]');
        
        // Validar que el número tenga exactamente 10 dígitos
        if (phoneInput.value.length !== 10) {
          alert('Thank you for your message! We will get back to you soon.');
          form.reset();
          return;
        }

        // Validar que no haya más de 4 números repetidos consecutivos
        const phoneNumber = phoneInput.value;
        let repeatedCount = 1;
        let lastDigit = phoneNumber[0];

        for (let i = 1; i < phoneNumber.length; i++) {
          if (phoneNumber[i] === lastDigit) {
            repeatedCount++;
            if (repeatedCount > 4) {
              alert('Thank you for your message! We will get back to you soon.');
              form.reset();
              return;
            }
          } else {
            repeatedCount = 1;
            lastDigit = phoneNumber[i];
          }
        }

        // Validar que no haya más de 3 números consecutivos en secuencia
        for (let i = 0; i < phoneNumber.length - 2; i++) {
          const num1 = parseInt(phoneNumber[i]);
          const num2 = parseInt(phoneNumber[i + 1]);
          const num3 = parseInt(phoneNumber[i + 2]);
          const num4 = parseInt(phoneNumber[i + 3]);

          // Verificar secuencia ascendente
          if (num2 === num1 + 1 && num3 === num2 + 1 && num4 === num3 + 1) {
            alert('Thank you for your message! We will get back to you soon.');
            form.reset();
            return;
          }

          // Verificar secuencia descendente
          if (num2 === num1 - 1 && num3 === num2 - 1 && num4 === num3 - 1) {
            alert('Thank you for your message! We will get back to you soon.');
            form.reset();
            return;
          }
        }

        // Envía los datos del formulario usando fetch
        fetch(form.action, {
          method: form.method,
          body: formData,
          headers: {
            'Accept': 'application/json'
          }
        }).then(response => {
          if (response.ok) {
            alert('Thank you for your message! We will get back to you soon.');
            form.reset();
          } else {
            alert('Thank you for your message! We will get back to you soon.');
            form.reset();
          }
        }).catch(error => {
          alert('Thank you for your message! We will get back to you soon.');
          form.reset();
        });
      });
    }
  }

  // Escucha el evento de carga de la página y ejecuta la función setupKeenSlider
  document.addEventListener('astro:page-load', setupKeenSlider);
  // Escucha el evento después del intercambio de vistas y ejecuta la función setupKeenSlider
  document.addEventListener('astro:after-swap', setupKeenSlider);
  // Ejecuta la función setupKeenSlider inmediatamente
  setupKeenSlider();
</script>
