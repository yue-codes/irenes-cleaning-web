---
const faqs = [
  {
    question: "What areas do you serve?",
    answer: "We provide professional cleaning services in Jersey City, Hoboken, Newark, Orange, Maplewood, Bayonne, and surrounding areas in New Jersey. Jersey City and Hoboken make up 95% of our service area."
  },
  {
    question: "How much does house cleaning cost in Jersey City?",
    answer: "We offer free, no-obligation quotes based on your home's size and specific needs. Every home is different, so we personalize our pricing to give you the best value. Contact us to get your free estimate today."
  },
  {
    question: "What's included in a deep cleaning?",
    answer: "Our deep cleaning service covers every corner of your home: scrubbing bathrooms and kitchen appliances, cleaning inside cabinets, baseboards, window sills, light fixtures, and areas that aren't part of a standard clean. It's ideal for first-time clients or homes that haven't had a thorough cleaning in a while."
  },
  {
    question: "Do I need to be home during the cleaning?",
    answer: "No — many of our clients in Jersey City and Hoboken give us a key or door code. Our team is fully professional and trustworthy. You can go about your day and return to a spotless home."
  },
  {
    question: "Are your cleaning products safe for kids and pets?",
    answer: "Yes. We use safe, adaptable cleaning products and can accommodate specific preferences or sensitivities. Just let us know your needs when booking and we'll adjust accordingly."
  },
  {
    question: "Do you offer last-minute or same-day cleaning?",
    answer: "Yes! We offer last-minute cleaning services in Jersey City and Hoboken. Emergencies happen — call us and our team will do its best to accommodate you as quickly as possible."
  },
  {
    question: "Do you offer a satisfaction guarantee?",
    answer: "Absolutely. We guarantee our cleaning or your money back. Your home is your sanctuary and we take that seriously. If something wasn't done to your satisfaction, we'll come back and make it right."
  },
  {
    question: "How do I book a cleaning?",
    answer: "You can book directly through the contact form on our website or call us at (201) 523-8741. We'll confirm your appointment and adapt to your schedule — no upfront payment required."
  }
];
---

<section class="max-w-3xl mx-auto px-4 py-20">
  <h2 class="text-4xl lg:text-5xl font-bold text-center text-heading-1 mb-4">
    Frequently Asked Questions
  </h2>
  <p class="text-center text-heading-2 mb-12">
    Everything you need to know about our cleaning services in Jersey City & Hoboken, NJ.
  </p>

  <div class="space-y-3">
    {faqs.map((faq, i) => (
      <details class="group border border-gray-200 rounded-xl overflow-hidden bg-white shadow-sm">
        <summary class="flex items-center justify-between gap-4 px-6 py-4 font-semibold text-heading-1 cursor-pointer list-none">
          {faq.question}
          <span class="shrink-0 text-purple-600 transition-transform duration-300 group-open:rotate-180">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m6 9 6 6 6-6"/>
            </svg>
          </span>
        </summary>
        <p class="px-6 pb-5 text-heading-2 leading-relaxed">
          {faq.answer}
        </p>
      </details>
    ))}
  </div>
</section>

<script type="application/ld+json">
