<script is:inline data-astro-rerun>
  function setupReviews() {
    const slider = document.getElementById('reviews-slider');
    if (!slider) return;

    const slides = Array.from(slider.children);
    const activeEl = document.getElementById('reviews-active');
    const prevBtn = document.getElementById('reviews-prev');
    const nextBtn = document.getElementById('reviews-next');
    let activeIndex = 0;

    function updateActive() {
      let closest = 0;
      let minDist = Infinity;
      slides.forEach((slide, i) => {
        const dist = Math.abs(slider.scrollLeft - slide.offsetLeft);
        if (dist < minDist) { minDist = dist; closest = i; }
      });
      slides.forEach(s => s.classList.add('opacity-40'));
      slides[closest].classList.remove('opacity-40');
      activeIndex = closest;
      activeEl.textContent = closest + 1;
    }

    slider.addEventListener('scroll', updateActive, { passive: true });
    updateActive();

    prevBtn.addEventListener('click', () => {
      slides[Math.max(0, activeIndex - 1)].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' });
    });

    nextBtn.addEventListener('click', () => {
      slides[Math.min(slides.length - 1, activeIndex + 1)].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' });
    });
  }

  document.addEventListener('astro:page-load', setupReviews);
  document.addEventListener('astro:after-swap', setupReviews);
  setupReviews();
</script>
