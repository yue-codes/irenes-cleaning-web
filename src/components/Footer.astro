---
const currentYear = new Date().getFullYear();
---

<footer class="bg-gray-900 text-gray-400">
  <div class="mx-auto max-w-screen-xl px-6 py-16">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-10">

      <!-- Brand -->
      <div class="col-span-2 lg:col-span-1">
        <a href="/" class="inline-block mb-5">
          <img src="/logo1.webp" alt="Mrs. Irene's Cleaning logo" class="h-16 w-auto" />
        </a>
        <p class="text-sm leading-relaxed mb-4">
          Professional cleaning services in Jersey City, Hoboken, and surrounding NJ areas.
        </p>
        <p class="text-xs text-gray-500">
          Jersey City & Hoboken, NJ<br />
          Newark · Orange · Maplewood · Bayonne
        </p>
      </div>

      <!-- Services -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white mb-5">Services</h3>
        <ul class="space-y-3 text-sm">
          <li><a href="/services/deep-cleaning" class="hover:text-purple-400 transition-colors duration-200">Deep Cleaning</a></li>
          <li><a href="/services/standard-cleaning" class="hover:text-purple-400 transition-colors duration-200">Standard Cleaning</a></li>
          <li><a href="/services/move-in-out-cleaning" class="hover:text-purple-400 transition-colors duration-200">Move-In / Move-Out</a></li>
          <li><a href="/services/airbnb-cleaning" class="hover:text-purple-400 transition-colors duration-200">Airbnb Turnover</a></li>
          <li><a href="/services/commercial-cleaning" class="hover:text-purple-400 transition-colors duration-200">Commercial</a></li>
          <li><a href="/services/custom-add-ons" class="hover:text-purple-400 transition-colors duration-200">Custom Add-ons</a></li>
        </ul>
      </div>

      <!-- Quick links -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white mb-5">Quick Links</h3>
        <ul class="space-y-3 text-sm">
          <li><a href="/" class="hover:text-purple-400 transition-colors duration-200">Home</a></li>
          <li><a href="/services" class="hover:text-purple-400 transition-colors duration-200">All Services</a></li>
          <li><a href="/#about" class="hover:text-purple-400 transition-colors duration-200">About Us</a></li>
          <li><a href="/contact" class="hover:text-purple-400 transition-colors duration-200">Contact</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div class="col-span-2 lg:col-span-1">
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white mb-5">Contact</h3>
        <ul class="space-y-3 text-sm">
          <li>
            <a href="mailto:info@mrsirenescleaning.com" class="hover:text-purple-400 transition-colors duration-200">
              info@mrsirenescleaning.com
            </a>
          </li>
          <li class="pt-2">
            <a
              href="/#contact"
              class="inline-block bg-purple-600 hover:bg-purple-500 text-white text-sm font-semibold px-5 py-2.5 rounded-full transition-colors duration-200"
              href="/contact"
            >
              Get a Free Quote
            </a>
          </li>
        </ul>
      </div>

    </div>

    <hr class="my-10 border-white/10" />

    <p class="text-center text-xs text-gray-600">
      © {currentYear} Mrs. Irene's Cleaning. All rights reserved.
    </p>
  </div>
</footer>
