---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Page Not Found | Mrs. Irene's Cleaning"
  description="The page you're looking for doesn't exist. Visit Mrs. Irene's Cleaning to find professional cleaning services in Jersey City & Hoboken, NJ."
>
  <section
    class="relative min-h-screen flex items-center justify-center overflow-hidden"
    style="background: linear-gradient(135deg, #0f0520 0%, #1e0845 50%, #0a0518 100%);"
  >
    <!-- 404 as giant backdrop -->
    <span
      class="absolute inset-0 flex items-center justify-center font-black select-none pointer-events-none leading-none"
      style="font-size: clamp(180px, 40vw, 500px); color: rgba(255,255,255,0.03);"
    >
      404
    </span>

    <!-- Content -->
    <div class="relative text-center text-white px-6 max-w-xl mx-auto py-32">

      <!-- Icon -->
      <div class="w-16 h-16 bg-purple-600/20 border border-purple-500/30 rounded-2xl flex items-center justify-center mx-auto mb-8">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-purple-400">
          <path d="M3 21l9-9m0 0l4.5-4.5M12 12l-4.5-4.5M12 12l4.5 4.5M7.5 3L12 7.5m0 0L16.5 3M12 7.5V3"/>
          <path d="M9 15l-6 6"/>
          <path d="M21 3l-6 6"/>
        </svg>
      </div>

      <!-- Label -->
      <p class="text-purple-400 text-sm font-semibold uppercase tracking-widest mb-4">Error 404</p>

      <!-- Heading -->
      <h1 class="text-4xl lg:text-5xl font-bold mb-5 leading-tight">
        This page needs a deep clean.
      </h1>

      <!-- Subtext -->
      <p class="text-white/50 text-lg mb-12 leading-relaxed">
        We couldn't find what you were looking for. Let us help you get back on track.
      </p>

      <!-- Quick links -->
      <div class="flex flex-wrap justify-center gap-3 mb-10">
        <a href="/" class="px-5 py-2.5 rounded-full border border-white/20 text-sm text-white/70 hover:bg-white/10 hover:text-white transition-all duration-200">
          Home
        </a>
        <a href="/services" class="px-5 py-2.5 rounded-full border border-white/20 text-sm text-white/70 hover:bg-white/10 hover:text-white transition-all duration-200">
          Our Services
        </a>
        <a href="/contact" class="px-5 py-2.5 rounded-full border border-white/20 text-sm text-white/70 hover:bg-white/10 hover:text-white transition-all duration-200">
          Contact
        </a>
      </div>

      <!-- CTA -->
      <a
        href="/"
        class="inline-block bg-purple-600 hover:bg-purple-500 text-white font-bold px-10 py-4 rounded-full transition-colors duration-200"
      >
        Back to Home
      </a>
    </div>
  </section>

  <Footer />
</Layout>
