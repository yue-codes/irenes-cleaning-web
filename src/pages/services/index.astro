---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import FormsContact from '../../components/FormsContact.astro';
import { servicesData } from '../../utils/servicesData.ts';
---

<Layout
  title="Cleaning Services in Jersey City & Hoboken, NJ | Mrs. Irene's Cleaning"
  description="Professional cleaning services in Jersey City & Hoboken, NJ. Deep cleaning, standard, move-in/out, Airbnb, commercial & custom add-ons. Free quote, no upfront payment."
  canonical="https://mrsirenescleaning.com/services"
>
  <!-- Hero -->
  <section
    class="relative bg-cover bg-center pt-40 pb-20 text-white"
    style="background-image: url('/hero2.webp')"
  >
    <div class="absolute inset-0 bg-gray-900/80"></div>
    <div class="relative max-w-3xl mx-auto px-6 text-center">
      <p class="text-purple-300 text-sm font-semibold uppercase tracking-widest mb-4">
        Mrs. Irene's Cleaning
      </p>
      <h1 class="text-4xl lg:text-5xl font-bold mb-5">
        Professional Cleaning Services<br class="hidden sm:block" />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-400">
          in Jersey City & Hoboken, NJ
        </span>
      </h1>
      <p class="text-white/70 text-lg max-w-xl mx-auto">
        From regular maintenance to deep cleans and move-in/out services — we have the right solution for every home and business.
      </p>
    </div>
  </section>

  <!-- Services grid -->
  <section class="max-w-7xl mx-auto px-6 py-20">
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {servicesData.map((service) => {
        const allItems = service.sections.flatMap((s) => s.items).slice(0, 3);
        return (
          <a
            href={`/services/${service.slug}`}
            class="group block rounded-2xl overflow-hidden border border-gray-200 shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1"
          >
            <!-- Image -->
            <div class="relative h-52 overflow-hidden">
              <div
                class="absolute inset-0 bg-cover bg-center group-hover:scale-105 transition-transform duration-500"
                style={`background-image: url('/${service.image}')`}
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/40 to-black/20" />
              <div class="absolute bottom-0 left-0 p-5">
                <h2 class="text-xl font-bold text-white leading-tight">{service.name}</h2>
              </div>
            </div>

            <!-- Content -->
            <div class="p-6 bg-white flex flex-col h-[calc(100%-13rem)]">
              <p class="text-gray-500 text-sm mb-5 leading-relaxed">{service.tagline}</p>
              <ul class="space-y-2 mb-6 flex-1">
                {allItems.map((item) => (
                  <li class="flex items-start gap-2 text-sm text-gray-700">
                    <svg
                      class="shrink-0 mt-0.5 text-purple-500"
                      width="15"
                      height="15"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M20 6 9 17l-5-5" />
                    </svg>
                    <span class="line-clamp-2">{item}</span>
                  </li>
                ))}
              </ul>
              <span class="inline-flex items-center gap-1.5 text-purple-600 font-semibold text-sm group-hover:gap-3 transition-all duration-200">
                View Details
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
              </span>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-purple-700 text-white">
    <div class="max-w-3xl mx-auto px-6 py-20 text-center">
      <h2 class="text-3xl lg:text-4xl font-bold mb-4">
        Not sure which service is right for you?
      </h2>
      <p class="text-purple-200 text-lg mb-10">
        Contact us and we'll help you find the perfect cleaning solution for your home or business in Jersey City & Hoboken.
      </p>
      <a
        href="/#contact"
        class="inline-block bg-white text-purple-700 font-bold px-12 py-4 rounded-full hover:bg-purple-50 transition-colors"
      >
        Get a Free Quote
      </a>
    </div>
  </section>

  <FormsContact />
  <Footer />
</Layout>
