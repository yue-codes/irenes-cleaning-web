---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import { servicesData } from '../../utils/servicesData.ts';
import type { ServiceData } from '../../utils/servicesData.ts';

export function getStaticPaths() {
  return servicesData.map((s) => ({
    params: { service: s.slug },
    props: { service: s },
  }));
}

interface Props {
  service: ServiceData;
}

const { service } = Astro.props;
const canonical = `https://mrsirenescleaning.com/services/${service.slug}`;
const otherServices = servicesData.filter((s) => s.slug !== service.slug);
const relatedServices = otherServices.slice(0, 3);
---

<Layout
  title={service.metaTitle}
  description={service.metaDescription}
  canonical={canonical}
>
  <!-- Hero -->
  <section
    class="relative min-h-[60vh] flex items-end bg-cover bg-center"
    style={`background-image: url('/${service.image}')`}
  >
    <div class="absolute inset-0 bg-gray-900/75"></div>
    <div class="relative max-w-4xl mx-auto px-6 py-20 text-white w-full">
      <nav class="text-sm mb-6 opacity-70 flex gap-2" aria-label="Breadcrumb">
        <a href="/" class="hover:opacity-100">Home</a>
        <span>/</span>
        <a href="/services" class="hover:opacity-100">Services</a>
        <span>/</span>
        <span>{service.name}</span>
      </nav>
      <h1 class="text-4xl lg:text-5xl font-bold mb-4 leading-tight">{service.title}</h1>
      <p class="text-xl text-purple-200 mb-8">{service.tagline}</p>
      <a
        href="/contact"
        class="inline-block bg-purple-600 hover:bg-purple-700 text-white font-semibold px-8 py-4 rounded-full transition duration-200"
      >
        Get a Free Quote
      </a>
    </div>
  </section>

  <!-- Other services pills -->
  <div class="border-b border-gray-100 bg-gray-50">
    <div class="max-w-4xl mx-auto px-6 py-4 flex items-center gap-4">
      <span class="text-xs font-semibold uppercase tracking-wider text-gray-400 shrink-0">Other services:</span>
      <div class="flex gap-2 overflow-x-auto pb-1" style="scrollbar-width: none;">
        {otherServices.map((s) => (
          <a
            href={`/services/${s.slug}`}
            class="shrink-0 px-4 py-1.5 rounded-full border border-gray-200 text-sm text-gray-600 hover:bg-purple-600 hover:text-white hover:border-purple-600 transition-all duration-200 whitespace-nowrap"
          >
            {s.name}
          </a>
        ))}
      </div>
    </div>
  </div>

  <!-- Content -->
  <section class="max-w-4xl mx-auto px-6 py-16">
    <p class="text-lg text-gray-700 leading-relaxed mb-14">{service.intro}</p>

    <div class="space-y-12">
      {service.sections.map((section) => (
        <div>
          <h2 class="text-2xl font-bold text-purple-800 mb-5 pb-2 border-b border-purple-100">
            {section.title}
          </h2>
          <ul class="space-y-3">
            {section.items.map((item) => (
              <li class="flex gap-3 items-start text-gray-700">
                <svg
                  class="shrink-0 mt-0.5 text-purple-600"
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M20 6 9 17l-5-5" />
                </svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    {service.note && (
      <div class="mt-12 bg-purple-50 border border-purple-200 rounded-xl p-6 text-purple-900">
        <p class="font-semibold mb-1">Important note:</p>
        <p>{service.note}</p>
      </div>
    )}
  </section>

  <!-- Related services cards -->
  <section class="max-w-4xl mx-auto px-6 pb-16">
    <h2 class="text-xl font-bold text-gray-900 mb-6">You might also need</h2>
    <div class="grid sm:grid-cols-3 gap-4">
      {relatedServices.map((s) => (
        <a
          href={`/services/${s.slug}`}
          class="group flex gap-4 p-4 rounded-2xl border border-gray-200 hover:border-purple-300 hover:shadow-md transition-all duration-200"
        >
          <div
            class="w-16 h-16 shrink-0 rounded-xl bg-cover bg-center group-hover:scale-105 transition-transform duration-300"
            style={`background-image: url('/${s.image}')`}
          />
          <div class="min-w-0">
            <h3 class="font-semibold text-gray-900 text-sm leading-snug">{s.name}</h3>
            <p class="text-xs text-gray-500 mt-1 line-clamp-2 leading-relaxed">{s.tagline}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-purple-700 text-white">
    <div class="max-w-3xl mx-auto px-6 py-16 text-center">
      <h2 class="text-3xl lg:text-4xl font-bold mb-4">
        Ready for a spotless space?
      </h2>
      <p class="text-purple-200 text-lg mb-8">
        Serving Jersey City, Hoboken, and surrounding NJ areas. Free quote, no upfront payment.
      </p>
      <a
        href="/contact"
        class="inline-block bg-white text-purple-700 font-bold px-10 py-4 rounded-full hover:bg-purple-50 transition duration-200"
      >
        Contact Us Now
      </a>
    </div>
  </section>

  <Footer />
</Layout>
