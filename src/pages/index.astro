---
import Bento from '../components/Bento.astro';
import Hero from '../components/Hero.astro';
import Layout from '../layouts/Layout.astro';
import Services from '../components/Services.astro';
import Numeros from '../components/Numeros.astro';
import Reviews from '../components/Reviews.astro';
import FormsContact from '../components/FormsContact.astro';
import Footer from '../components/Footer.astro';
import Popup from '../components/Popup';
---

<Layout title="Mrs. Irene's Cleaning | Professional Cleaning Service in Jersey City & Hoboken, NJ"
	description="Professional cleaning service in Jersey City & Hoboken, NJ. Deep cleaning, move-in/out, Airbnb & regular cleaning. Fast, affordable and personalized. Book now!">
	
	<main>
		<Popup client:load/>
		<Hero />
		<section class="relative bg-cover bg-center min-h-screen w-full" style="background-image: url('/fondo3.webp')">
			<div class="absolute inset-0 bg-white opacity-95"></div>
			<div class="relative z-10">
				<!-- Contenido de la sección -->
				<Numeros />
				<Reviews />
			</div>
		</section>
		
		<section class="relative bg-cover bg-center min-h-screen w-full" style="background-image: url('/fondo2.webp')">
			<div class="absolute inset-0 bg-white opacity-95"></div>
			<div class="relative z-10">
				<!-- Contenido de la sección -->
				<Services />
			</div>
		</section>
		
		<section class="relative bg-cover bg-center" style="background-image: url('/fondo.webp')">
			<div class="absolute inset-0 bg-white opacity-95"></div>
			<div class="relative z-10">
				<!-- Contenido de la sección -->
				<Bento />
			</div>
		</section>
		<FormsContact />
		
		
	</main>
	<Footer />

</Layout>

<style>
  .underline-pink::after {
    content: '';
    display: block;
    width: 120px; /* Ajusta este valor para cambiar el ancho de la línea */
    height: 2px; /* Grosor de la línea */
    background-color: #aa69ff; /* Color rosa */
    position: absolute;
    bottom: -10px; /* Ajusta esta distancia según sea necesario */
    left: 50%; /* Centra la línea horizontalmente */
    transform: translateX(-50%); /* Centra la línea horizontalmente */
  }

</style>

